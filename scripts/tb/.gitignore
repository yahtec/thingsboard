# Auto-generated backups before destructive operations on TB entities.
# Useful for forensic / local rollback but not for the shared repo.
backup/
widgets/tduo-backup/
dashboard/backup/

# Recovery / preview intermediate files (regenerated on demand).
dashboard/dash-recovered.json
*.preview.*.json

# Dashboard dumps generated by the dashboards/*.py patch scripts
# (backup-before / preview-after snapshots). Local rollback only.
dashboards/backup-*.json
dashboards/*.before_*.json
dashboards/*.preview_*.json
dashboards/preview-*.json

# Python bytecode cache
__pycache__/
*.pyc

# Nettoyage dashboards (2026-07-17) : rapports d'audit + exports avant suppression.
# Contiennent des donnees clients -> JAMAIS dans le repo public. Rollback local only.
dashboards/audit-*.md
dashboards/audit-*.json
dashboards/deleted/

# Identifiants des services deployes (tb-dispatcher/provision_watcher...).
# Le depot yahtec/thingsboard est PUBLIC : aucun secret ne doit y entrer.
.env
