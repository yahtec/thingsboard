# tb-notify — copy to .env and fill in.

# ThingsBoard — COMPTE DE SERVICE dédié (TENANT_ADMIN headless) pour les appels API.
# NE PAS utiliser un compte humain (traçabilité + rotation indépendante).
# Créé/recréé via scripts/tb/rbac/create_service_account.py.
TB_URL=http://127.0.0.1:8080
TB_USER=svc-tbnotify@yahtec.com
TB_PASS=changeme

# Tenant scope. Customer hosting the pac-hybride devices (used to read parc_admins
# attribute and to scope device discovery).
TB_CUSTOMER_ID=2e521d10-3e5d-11f1-bbfe-e1395562cba0
TB_DEVICE_PROFILE_NAME=pac hybride

# SMTP — Brevo (smtp-relay.brevo.com:587, STARTTLS).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@yahtec.com
SMTP_FROM_NAME=TDUO Alertes

# Fallback admin recipients for the parc recap if `parc_admins` attribute is
# absent on the customer. Comma-separated.
PARC_ADMINS_FALLBACK=je@yahtec.com,af@yahtec.com

# ─── Cadence des notifications de defaut ────────────────────────────────────
# Tous ces reglages ont un defaut dans le code : rien n'est obligatoire ici.

# Chaufferies muettes pour TOUS les mails (recap admin et mails client) —
# noms `entityName` separes par des virgules. Defaut code = 2610000001 (banc
# d'essai degrade, defauts non representatifs). Valeur vide = n'exclut rien.
# NOTIFY_EXCLUDE_DEVICES=2610000001

# Sursis entre l'apparition d'un defaut et le premier mail qui en parle, en
# minutes. Un defaut resolu pendant son sursis ne produit AUCUN mail : c'est
# ce qui filtre les defauts de communication qui battent de l'aile.
# MAIL_GRACE_MIN=60

# Heure locale du recap admin quotidien, et ecart minimal entre deux mails
# admin (supprime le quotidien s'il tombe juste apres un mail rapide).
# DIGEST_RECAP_HOUR=7
# DIGEST_MIN_GAP_HOURS=6

# Intervalle minimal entre deux mails rapides : limiteur anti-battement.
# DIGEST_FAST_QUOTA_HOURS=24

# Paliers d'escalade des rappels client sur un defaut non resolu, en heures.
# NOTIFY_REMINDER_HOURS=24,72,168

# Mini admin web app — secret used to sign session cookies (any random 64+ chars).
WEB_SECRET=change-this-to-a-long-random-string
WEB_BIND=127.0.0.1:8765
