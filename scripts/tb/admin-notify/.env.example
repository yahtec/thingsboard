# tb-notify — copy to .env and fill in.

# ThingsBoard — COMPTE DE SERVICE dédié (TENANT_ADMIN headless) pour les appels API.
# NE PAS utiliser un compte humain (traçabilité + rotation indépendante).
# Créé/recréé via scripts/tb/rbac/create_service_account.py.
TB_URL=http://127.0.0.1:8080
TB_USER=svc-tbnotify@yahtec.com
TB_PASS=changeme

# Tenant scope. Customer hosting the pac-hybride devices (used to read parc_admins
# attribute and to scope device discovery).
TB_CUSTOMER_ID=2e521d10-3e5d-11f1-bbfe-e1395562cba0
TB_DEVICE_PROFILE_NAME=pac hybride

# SMTP — Brevo (smtp-relay.brevo.com:587, STARTTLS).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@yahtec.com
SMTP_FROM_NAME=TDUO Alertes

# Fallback admin recipients for the 4-hour digest if `parc_admins` attribute is
# absent on the customer. Comma-separated.
PARC_ADMINS_FALLBACK=je@yahtec.com,af@yahtec.com

# Mini admin web app — secret used to sign session cookies (any random 64+ chars).
WEB_SECRET=change-this-to-a-long-random-string
WEB_BIND=127.0.0.1:8765
