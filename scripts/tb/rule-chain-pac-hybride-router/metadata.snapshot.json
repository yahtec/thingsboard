    },
    {
      "additionalInfo": {
        "description": "Anti-collision ts_kv : decale metadata.ts de (evt_fault*8 + evt_device) ms pour que deux defauts de la meme seconde n'ecrasent pas leurs cles partagees. Idempotent par retransmission.",
        "layoutX": 560,
        "layoutY": 210
      },
      "configuration": {
        "jsScript": "var f = msg.evt_fault;\nif (f !== null && f !== undefined && metadata.ts) {\n    var base = Math.floor(Number(metadata.ts) / 1000) * 1000;\n    var dev = Number(msg.evt_device);\n    if (isNaN(dev)) { dev = 0; }\n    var off = ((Number(f) * 8 + dev) % 1000 + 1000) % 1000;\n    metadata.ts = \"\" + (base + off);\n}\nreturn {msg: msg, metadata: metadata, msgType: msgType};",
