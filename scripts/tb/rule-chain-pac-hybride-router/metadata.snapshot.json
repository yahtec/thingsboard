        "tbelScript": "// scripts/tb/rule-chain-pac-hybride-router/extract-attrs.tbel\n//\n// TBEL TbTransformMsgNode (TB 4.3) — extraction des 40 attrs SERVER_SCOPE\n// du payload pac_v2 nested. Émet UN SEUL message POST_ATTRIBUTES_REQUEST\n// (pas de multi-msg, évite le bug TB 4.3 — cf. memory feedback-tbel-quirks).\n//\n// Conforme Section 3.6 du spec 2026-05-28-payload-v2-pac-hybride-design.md.\n// Le node \"Save Attrs SERVER_SCOPE v2\" a updateAttributesOnlyOnValueChange=true\n// → dédup natif, no-op si valeur identique.\n\nvar attrs = {};\n\n// --- Top-level (6) ---\nif (msg.id      != null) attrs.id = msg.id;\nif (msg.rel     != null) attrs.rel = msg.rel;\nif (msg.type    != null) attrs.type = msg.type;\nif (msg.nHp     != null) attrs.nHp = msg.nHp;\nif (msg.relCm2  != null) attrs.relCm2 = msg.relCm2;\nif (msg.nbPumpM != null) attrs.nbPumpM = msg.nbPumpM;  // nb pompes module (firmware 2026-06-12)\n\n// --- dhw : tSet + compteurs pompes echangeur (3) ---\nif (msg.dhw != null) {\n  if (msg.dhw.tSet       != null) attrs.dhw_tSet = msg.dhw.tSet;\n  if (msg.dhw.nbPumpPrim != null) attrs.dhw_nbPumpPrim = msg.dhw.nbPumpPrim;\n  if (msg.dhw.nbPumpSec  != null) attrs.dhw_nbPumpSec = msg.dhw.nbPumpSec;\n}\n\n// --- heat consignes + dates été (9) ---\nif (msg.heat != null) {\n  if (msg.heat.slope       != null) attrs.heat_slope = msg.heat.slope;\n  if (msg.heat.foot        != null) attrs.heat_foot = msg.heat.foot;\n  if (msg.heat.tMax        != null) attrs.heat_tMax = msg.heat.tMax;\n  if (msg.heat.tCut        != null) attrs.heat_tCut = msg.heat.tCut;\n  if (msg.heat.tRes        != null) attrs.heat_tRes = msg.heat.tRes;\n  if (msg.heat.dayBgEte    != null) attrs.heat_dayBgEte = msg.heat.dayBgEte;\n  if (msg.heat.monthBgEte  != null) attrs.heat_monthBgEte = msg.heat.monthBgEte;\n  if (msg.heat.dayEndEte   != null) attrs.heat_dayEndEte = msg.heat.dayEndEte;\n  if (msg.heat.monthEndEte != null) attrs.heat_monthEndEte = msg.heat.monthEndEte;\n\n  // --- heat.calo unités Modbus (5) ---\n  if (msg.heat.calo != null) {\n    if (msg.heat.calo.qeU    != null) attrs.heat_calo_qeU    = msg.heat.calo.qeU;\n    if (msg.heat.calo.qeTotU != null) attrs.heat_calo_qeTotU = msg.heat.calo.qeTotU;\n    if (msg.heat.calo.pwrU   != null) attrs.heat_calo_pwrU   = msg.heat.calo.pwrU;\n    if (msg.heat.calo.hKwhU  != null) attrs.heat_calo_hKwhU  = msg.heat.calo.hKwhU;\n    if (msg.heat.calo.cKwhU  != null) attrs.heat_calo_cKwhU  = msg.heat.calo.cKwhU;\n  }\n}\n\n// --- caloM unités Modbus (5) ---\nif (msg.caloM != null) {\n  if (msg.caloM.qeU    != null) attrs.caloM_qeU    = msg.caloM.qeU;\n  if (msg.caloM.qeTotU != null) attrs.caloM_qeTotU = msg.caloM.qeTotU;\n  if (msg.caloM.pwrU   != null) attrs.caloM_pwrU   = msg.caloM.pwrU;\n  if (msg.caloM.hKwhU  != null) attrs.caloM_hKwhU  = msg.caloM.hKwhU;\n  if (msg.caloM.cKwhU  != null) attrs.caloM_cKwhU  = msg.caloM.cKwhU;\n}\n\n// --- HPs[0..3] versions firmware sous-cartes (12 attrs max, skip empty strings) ---\nif (msg.HPs != null) {\n  // TBEL = MVEL-based : pas de for...in, utiliser boucle classique\n  var i = 0;\n  for (i = 0; i < msg.HPs.length; i++) {\n    var hp = msg.HPs[i];\n    if (hp != null) {\n      var prefix = \"HP\" + (i + 1) + \"_\";\n      if (hp.relStm != null && hp.relStm != \"\") attrs[prefix + \"relStm\"] = hp.relStm;\n      if (hp.relEsp != null && hp.relEsp != \"\") attrs[prefix + \"relEsp\"] = hp.relEsp;\n      if (hp.relScr != null && hp.relScr != \"\") attrs[prefix + \"relScr\"] = hp.relScr;\n    }\n  }\n}\n\nreturn {\n  msg: attrs,\n  metadata: metadata,\n  msgType: \"POST_ATTRIBUTES_REQUEST\"\n};\n"
      },
